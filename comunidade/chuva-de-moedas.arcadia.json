        "ClassName": "Script",
        "Name": "Rodadas",
        "props": {
         "Language": "Lua",
         "Enabled": true,
         "Source": "-- Chuva de Moedas: pegue o máximo que puder antes do tempo acabar.\n-- Moeda dourada vale 1, gema roxa vale 5.\nlocal jogador = game.Players.LocalPlayer\nlocal tela = script.Parent\nlocal relogio = tela:WaitForChild(\"Relogio\")\nlocal placar = tela:WaitForChild(\"Placar\")\nlocal aviso = tela:WaitForChild(\"Aviso\")\nlocal pasta = workspace:WaitForChild(\"MoedasDaRodada\")\n\nlocal DURACAO = 45\nlocal MAXIMO = 14\nlocal pontos, recorde = 0, 0\nlocal rodando = false\n\nlocal function tocar(nome)\n  local som = Instance.new(\"Sound\")\n  som.SoundId = nome\n  som.Parent = workspace\n  som:Play()\nend\n\nlocal function criarMoeda()\n  local gema = math.random() < 0.12\n  local m = Instance.new(\"Part\")\n  m.Name = gema and \"Gema\" or \"Moeda\"\n  m.Anchored = true\n  m.CanCollide = false\n  m.Material = \"Neon\"\n  if gema then\n    m.Shape = \"Ball\"\n    m.Size = Vector3.new(2, 2, 2)\n    m.Color = Color3.fromRGB(190, 90, 255)\n  else\n    m.Shape = \"Cylinder\"\n    m.Size = Vector3.new(0.4, 2.6, 2.6)\n    m.Color = Color3.fromRGB(245, 197, 24)\n  end\n  m.Position = Vector3.new(math.random(-34, 34), 2.5, math.random(-34, 34))\n  m.Parent = pasta\n  local pega = false\n  m.Touched:Connect(function(hit)\n    if pega or not rodando then return end\n    if game.Players:GetPlayerFromCharacter(hit.Parent) ~= jogador then return end\n    pega = true\n    pontos = pontos + (gema and 5 or 1)\n    placar.Text = \"🪙 \" .. pontos\n    tocar(gema and \"powerup\" or \"coin\")\n    m:Destroy()\n  end)\nend\n\nlocal function limpar()\n  for _, c in ipairs(pasta:GetChildren()) do c:Destroy() end\nend\n\nwhile true do\n  limpar()\n  pontos = 0\n  placar.Text = \"🪙 0\"\n  relogio.Text = \"⏱ \" .. DURACAO\n  aviso.Visible = true\n  for i = 3, 1, -1 do\n    aviso.Text = \"Prepare-se… \" .. i\n    tocar(\"click\")\n    wait(1)\n  end\n  aviso.Text = \"VAI!\"\n  rodando = true\n  local t, proxima = DURACAO, 0\n  while t > 0 do\n    local dt = wait(0.05)\n    t = t - dt\n    proxima = proxima - dt\n    if t < DURACAO - 1 then aviso.Visible = false end\n    relogio.Text = \"⏱ \" .. math.max(0, math.ceil(t))\n    if proxima <= 0 and #pasta:GetChildren() < MAXIMO then\n      criarMoeda()\n      proxima = 0.45\n    end\n    for _, c in ipairs(pasta:GetChildren()) do\n      c.Orientation = c.Orientation + Vector3.new(0, 6, 0)\n    end\n  end\n  rodando = false\n  tocar(\"win\")\n  local novo = pontos > recorde\n  if novo then recorde = pontos end\n  aviso.Visible = true\n  aviso.Text = (novo and \"🏆 Novo recorde! \" or \"Fim! \") .. pontos .. \" moedas · recorde \" .. recorde\n  wait(5)\nend\n"
        },
        "children": []
       }
      ]
