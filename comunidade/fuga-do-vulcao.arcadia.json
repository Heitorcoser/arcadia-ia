      "props": {
       "Language": "Lua",
       "Enabled": true,
       "Source": "-- cronômetro: conta os segundos de cada jogador até chegar ao topo (aparece no placar)\nlocal RunService = game:GetService(\"RunService\")\ngame.Players.PlayerAdded:Connect(function(jogador)\n  local stats = jogador:WaitForChild(\"leaderstats\")\n  local seg = Instance.new(\"IntValue\")\n  seg.Name = \"Segundos\"\n  seg.Parent = stats\n  local acumulado = 0\n  RunService.Heartbeat:Connect(function(dt)\n    if jogador:FindFirstChild(\"Escapou\") then return end\n    acumulado = acumulado + dt\n    if acumulado >= 1 then\n      acumulado = acumulado - 1\n      seg.Value = seg.Value + 1\n    end\n  end)\nend)"
      },
