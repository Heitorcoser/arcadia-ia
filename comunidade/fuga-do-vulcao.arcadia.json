        "props": {
         "Language": "Lua",
         "Enabled": true,
         "Source": "-- chegou ao topo: para o cronômetro e mostra o tempo\nscript.Parent.Touched:Connect(function(hit)\n  local jogador = game.Players:GetPlayerFromCharacter(hit.Parent)\n  if not jogador or jogador:FindFirstChild(\"Escapou\") then return end\n  local marca = Instance.new(\"BoolValue\")\n  marca.Name = \"Escapou\"\n  marca.Parent = jogador\n  local stats = jogador:FindFirstChild(\"leaderstats\")\n  local s = stats and stats:FindFirstChild(\"Segundos\")\n  local m = stats and stats:FindFirstChild(\"Moedas\")\n  local tela = Instance.new(\"ScreenGui\")\n  tela.Parent = jogador:FindFirstChild(\"PlayerGui\")\n  local txt = Instance.new(\"TextLabel\")\n  txt.Size = UDim2.new(0, 520, 0, 110)\n  txt.Position = UDim2.new(0.5, 0, 0.38, 0)\n  txt.AnchorPoint = Vector2.new(0.5, 0.5)\n  txt.Text = \"🌋 Você escapou do vulcão!\\n⏱️ \" .. (s and s.Value or 0) .. \" s  ·  🪙 \" .. (m and m.Value or 0) .. \" moedas\"\n  txt.TextSize = 34\n  txt.TextColor3 = Color3.fromRGB(255, 220, 140)\n  txt.BackgroundColor3 = Color3.fromRGB(45, 14, 8)\n  txt.CornerRadius = 16\n  txt.Parent = tela\n  local som = Instance.new(\"Sound\")\n  som.SoundId = \"win\"\n  som.Parent = script.Parent\n  som:Play()\n  print(jogador.Name .. \" escapou em \" .. (s and s.Value or 0) .. \" segundos\")\nend)"
